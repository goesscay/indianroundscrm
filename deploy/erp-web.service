# /etc/systemd/system/erp-web.service
[Unit]
Description=Indian Rounds ERP (Next.js)
After=network.target

[Service]
User=deploy
WorkingDirectory=/srv/erp/web
Environment=NODE_ENV=production
Environment=LARAVEL_URL=http://127.0.0.1:8081
ExecStart=/usr/local/bin/node /srv/erp/web/node_modules/next/dist/bin/next start -p 3100 -H 127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
