# /etc/systemd/system/erp-reverb.service
[Unit]
Description=Indian Rounds ERP - Laravel Reverb (WebSockets)
After=network.target

[Service]
User=deploy
WorkingDirectory=/srv/erp/api
ExecStart=/usr/bin/php artisan reverb:start --host=127.0.0.1 --port=8085
Restart=always
RestartSec=3
LimitNOFILE=10000

[Install]
WantedBy=multi-user.target
